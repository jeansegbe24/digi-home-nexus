# FastAPI Security Settings
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=generate-a-secure-random-32-byte-hex-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Supabase / RDS PostgreSQL)
# format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[dbname]
# Example for Supabase: postgresql+asyncpg://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host]:5432/[dbname]?ssl=require

# CORS & Cookie Security Config
ENVIRONMENT=production
VITE_FRONTEND_URL=https://app.digihome.com
EXTRA_CORS_ORIGINS=https://digihome.com,https://api.digihome.com
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Production Observability (Optional)
LOG_LEVEL=INFO
SENTRY_DSN=
